+/* KX3 session link-up — the compact counterpart to the QMX welcome block
+ * above. The KX3 and the I/Q dongle are TWO separate USB devices, so:
+ *   - CAT has nothing to enable for the panadapter (no Q9 IQ mode);
+ *   - there is no USB-audio TX path open, so nothing to defend against via VOX;
+ *   - its menus are not MM-addressable, so no CW-offset/GPS/band-table reads.
+ * What is worth doing:
+ *   - mark IQ mode "confirmed": the spectrum feeds from the dongle, not CAT;
+ *   - FA/MD/FW warm-up so the top-bar labels populate immediately (same as the
+ *     QMX path's warm-up block further down);
+ *   - VN; firmware version (same "VN<ver>;" shape the QMX produces);
+ *   - FR; ensure receive is on VFO A (Kenwood 0/1/2, identical on the KX3) —
+ *     ask first, write only if it needs it, and never touch FT/SP: the same
+ *     restraint the QMX FR block observes.
+ * Runs on link_task, which owns the pipe before poll_task exists. */
+static void kx3_link_up(void)
+{
+    s_iq_mode_confirmed = true;
+    s_vox_disabled = false;
+
+    {
+        static const char *const warmup[] = { "FA;", "MD;", "FW;" };
+        for (size_t wi = 0; wi < sizeof(warmup) / sizeof(warmup[0]); wi++) {
+            esp_err_t werr = cdc_acm_host_data_tx_blocking(
+                s_cdc_dev, (const uint8_t *)warmup[wi], strlen(warmup[wi]), 200);
+            if (werr != ESP_OK) {
+                ESP_LOGW(TAG, "KX3 warmup %s send failed: 0x%x", warmup[wi], werr);
+            }
+            vTaskDelay(pdMS_TO_TICKS(40));
+        }
+    }
+
+    cdc_acm_host_data_tx_blocking(s_cdc_dev, (const uint8_t *)"VN;", 3, 200);
+    vTaskDelay(pdMS_TO_TICKS(100));
+
+    {
+        s_rx_vfo_mode = -1;
+        cdc_acm_host_data_tx_blocking(s_cdc_dev, (const uint8_t *)"FR;", 3, 200);
+        for (int wi = 0; wi < 10 && s_rx_vfo_mode < 0; wi++) {
+            vTaskDelay(pdMS_TO_TICKS(20));
+        }
+        if (s_rx_vfo_mode < 0) {
+            ESP_LOGW(TAG, "KX3 VFO mode: no answer to FR; - leaving the radio alone");
+        } else if (s_rx_vfo_mode == 0) {
+            ESP_LOGI(TAG, "KX3 VFO mode: receiving on VFO A, as this firmware assumes");
+        } else {
+            ESP_LOGW(TAG, "KX3 VFO mode: radio was receiving on VFO %d - switching to VFO A",
+                     s_rx_vfo_mode);
+            cdc_acm_host_data_tx_blocking(s_cdc_dev, (const uint8_t *)"FR0;", 4, 200);
+            vTaskDelay(pdMS_TO_TICKS(60));
+            s_rx_vfo_mode = -1;
+            cdc_acm_host_data_tx_blocking(s_cdc_dev, (const uint8_t *)"FR;", 3, 200);
+            for (int wi = 0; wi < 10 && s_rx_vfo_mode < 0; wi++) {
+                vTaskDelay(pdMS_TO_TICKS(20));
+            }
+            if (s_rx_vfo_mode != 0) {
+                ESP_LOGW(TAG, "KX3 VFO mode: still reads %d after FR0; - the radio "
+                              "is not taking it", s_rx_vfo_mode);
+            }
+        }
+        /* CAT is proven alive the moment the radio answered the FR; ask - the
+         * same first-reply evidence the QMX path's FW; parser uses (everything
+         * tx-side that gates on cat_is_ready() - FSK keying, record, the
+         * wspr/ft8 lanes - feeds off this flag). */
+        if (s_rx_vfo_mode >= 0) s_cat_ready = true;
+    }
+}
